-        params.spawn_config.clone(),
-        &params.parent_history,
-        &params.node_repl_policy,
-    )
-    .await?;
-    Ok(PreparedReview {
-        context: Arc::new(context),
-        params: Arc::new(params),
-        recovery_requested: Arc::default(),
-    })
-}
