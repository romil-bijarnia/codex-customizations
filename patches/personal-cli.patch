-pub enum ReviewDeadline {
-    At(Instant),
-    Unlimited,
-}
-
-impl ReviewDeadline {
-    pub fn from_timeout(timeout: Option<Duration>) -> Self {
-        match timeout {
-            Some(timeout) => Self::At(Instant::now() + timeout),
-            None => Self::Unlimited,
-        }
-    }
-
-    pub(crate) fn is_elapsed(self) -> bool {
