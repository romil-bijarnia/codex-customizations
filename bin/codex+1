#!/usr/bin/env python3
"""A plain terminal connection to the Codex editing backend. No TUI or SDK."""
import json
import os
from pathlib import Path
import readline
import subprocess
import sys
import time

ROOT = Path(__file__).resolve().parent.parent
MODEL = 'gpt-5.6-luna'
INSTRUCTIONS = '''Make exactly the Codex launcher changes requested, adding, removing, or editing code as needed.
Run only the checks and build/install steps needed for that change. Fix resulting errors until the launcher works as intended, then stop.
Do not ask questions, expand scope, or do unrelated cleanup. If genuinely blocked, state the blocker instead of claiming success. Keep the final result brief.
Follow applicable repository instructions. Preserve unrelated edits, data, existing sessions, and the shared backend. No backups, AI credits, or co-author trailers.'''


def main():
    if sys.argv[1:] in (['--help'], ['-h']):
        print('Usage: codex+1 ["request"]  (or pipe code/context on stdin)\n'
              'GPT-5.6-Luna / xhigh / Daybreak Blue. One request, then exit.')
        return
    home = Path(os.environ.get('CODEX_HOME', Path.home() / '.codex')).expanduser()
    native = home / 'packages/standalone/current/bin/codex'
    cwd = str(Path(os.environ.get('CODEX_PLUS_CWD', ROOT)).resolve())
    overrides = {key: False for key in ('features.plugins', 'features.apps', 'features.hooks',
        'features.multi_agent', 'features.memories', 'features.chronicle', 'cloud.skills.enabled',
        'skills.bundled.enabled', 'skills.include_instructions')}
    overrides.update(model_reasoning_effort='xhigh', project_doc_max_bytes=0, web_search='disabled')
    env = {k: v for k, v in os.environ.items() if k not in ('CODEX_THREAD_ID', 'CODEX_SESSION_ID')}
    backend = subprocess.Popen([str(native), 'app-server', '--stdio'], env=env,
        stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True, encoding='utf-8')
    sequence, completed = 0, None

    def send(message):
        backend.stdin.write(json.dumps(message) + '\n')
        backend.stdin.flush()

    def receive():
        nonlocal completed
        line = backend.stdout.readline()
        if not line:
            raise RuntimeError('The Codex backend disconnected.')
        message = json.loads(line)
        method, params = message.get('method'), message.get('params', {})
        if method == 'item/agentMessage/delta':
            print(params['delta'], end='', flush=True)
        elif method == 'model/rerouted':
            raise RuntimeError(f"Backend rerouted {MODEL} to {params.get('toModel')}; stopping.")
        elif method == 'turn/completed':
            completed = params['turn']
        elif method == 'error' and not params.get('willRetry', False):
            raise RuntimeError(params.get('error', {}).get('message', str(params)))
        elif method == 'currentTime/read' and 'id' in message:
            send({'id': message['id'], 'result': {'currentTimeAt': int(time.time())}})
        elif 'id' in message and method:
            send({'id': message['id'], 'error': {'code': -32601, 'message': 'Interactive requests are disabled.'}})
            raise RuntimeError(f'Unexpected backend request: {method}')
        return message

    def rpc(method, params):
        nonlocal sequence
        sequence += 1
        send({'id': sequence, 'method': method, 'params': params})
        while True:
            message = receive()
            if 'method' not in message and message.get('id') == sequence:
                if 'error' in message:
                    raise RuntimeError(message['error']['message'])
                return message['result']

    try:
        rpc('initialize', {'clientInfo': {'name': 'codex_plus_one', 'version': '1'},
                           'capabilities': {'experimentalApi': True}})
        send({'method': 'initialized', 'params': {}})
        config = rpc('config/read', {'cwd': cwd, 'includeLayers': False})['config']
        overrides.update({f'mcp_servers.{name}.enabled': False for name in config.get('mcp_servers', {})})
        thread = rpc('thread/start', {'model': MODEL, 'allowProviderModelFallback': False,
            'cwd': cwd, 'approvalPolicy': 'never',
            'sandbox': 'danger-full-access', 'ephemeral': True, 'baseInstructions': INSTRUCTIONS,
            'developerInstructions': '', 'config': overrides})
        if thread['model'] != MODEL or thread['reasoningEffort'] != 'xhigh':
            raise RuntimeError('Backend did not accept GPT-5.6-Luna / xhigh.')
        readline.parse_and_bind('set enable-bracketed-paste on')
        text = ' '.join(sys.argv[1:]) or (input('> ') if sys.stdin.isatty() else sys.stdin.read())
        if text.strip():
            rpc('turn/start', {'threadId': thread['thread']['id'], 'model': MODEL, 'effort': 'xhigh',
                'cyberAccessProgram': 'daybreakBlue', 'input': [{'type': 'text', 'text': text}]})
            while completed is None:
                receive()
            print(flush=True)
            if completed['status'] != 'completed':
                raise RuntimeError(str(completed.get('error') or completed['status']))
    except EOFError:
        pass
    finally:
        backend.terminate()
        try:
            backend.wait(timeout=5)
        except subprocess.TimeoutExpired:
            backend.kill()
            backend.wait()
        backend.stdin.close()
        backend.stdout.close()


if __name__ == '__main__':
    try:
        main()
    except KeyboardInterrupt:
        raise SystemExit(130)
    except (OSError, RuntimeError, ValueError, KeyError) as error:
        print(f'codex+1: {error}', file=sys.stderr)
        raise SystemExit(1)
